{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "title": "JED replay trace",
  "type": "object",
  "required": ["seed", "user_messages", "tool_events"],
  "properties": {
    "seed": {"type": "integer"},
    "user_messages": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 10000}},
    "assistant_messages": {"type": "array", "items": {"type": "string"}},
    "egress": {"type": "array", "items": {"type": "object"}},
    "tool_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "args", "ok", "output", "side_effect", "scope", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1}, "args": {"type": "object"},
          "ok": {"type": "boolean"}, "output": {"type": "string"},
          "side_effect": {"enum": ["READ", "WRITE", "SHARE", "EXEC"]},
          "scope": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  }
}
